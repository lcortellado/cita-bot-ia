{
  "name": "cita-bot",
  "version": "1.0.0",
  "description": "WhatsApp AI agent that answers customers and books appointments.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env agente.js",
    "simular": "node --env-file=.env simular.js",
    "probar": "node --env-file=.env probar.js",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.6.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
