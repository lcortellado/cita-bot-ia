# Copy this file to .env and fill it in. Never commit .env (it holds your keys).

# ---- WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API Setup / Configuration)
WHATSAPP_TOKEN=your-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# A secret you choose; type the same value in Meta's "Verify token" field
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
# App settings > Basic > App secret (verifies that webhook requests come from Meta)
WHATSAPP_APP_SECRET=your-app-secret
# Optional: Graph API version (default v25.0)
WHATSAPP_GRAPH_VERSION=

# ---- OpenRouter (openrouter.ai > Keys)
OPENROUTER_API_KEY=your-openrouter-api-key
# Any model with tool support (openrouter.ai/models)
OPENROUTER_MODEL=google/gemini-3.8-flash

# ---- Cal.com (leave empty to use the in-memory demo calendar)
# Cal.com > Settings > Security > API keys
CAL_API_KEY=
# Event type id (shown in the URL when you open the event in Cal.com)
CAL_EVENT_TYPE_ID=
# Optional: business email used for bookings, if your event type requires an email
CAL_DEFAULT_EMAIL=

# ---- General
# development | production (production requires WHATSAPP_APP_SECRET)
NODE_ENV=development
TIMEZONE=America/Asuncion
PORT=3000
