# Copia este archivo a .env y complétalo. Nunca publiques el .env (tiene tus claves).

# ---- paso 2 · WhatsApp (developers.facebook.com > tu app > WhatsApp > API Setup / Configuration)
WHATSAPP_TOKEN=coloca-aqui-el-token-de-acceso
WHATSAPP_PHONE_NUMBER_ID=coloca-aqui-el-phone-number-id
# una contraseña que TÚ inventas y escribes igual en el campo "Verify token" de Meta
WHATSAPP_VERIFY_TOKEN=inventa-una-contrasena-larga
# App settings > Basic > App secret (verifica que quien llamó el webhook fue Meta)
WHATSAPP_APP_SECRET=coloca-aqui-el-app-secret

# ---- paso 3 · modelo (openrouter.ai > Keys)
OPENROUTER_API_KEY=coloca-aqui-tu-api-key
# cualquier modelo con soporte a herramientas (tools) en openrouter.ai/models
MODELO=google/gemini-3.8-flash

# ---- paso 6 · agenda (dejar vacío para usar la agenda de demostración)
# Cal.com > Settings > Security > API keys
CAL_API_KEY=
# el número del tipo de evento (aparece en la URL cuando abres el evento en Cal.com)
CAL_EVENT_TYPE_ID=
# opcional: email del negocio usado en los agendamientos, si tu tipo de evento exige email
CAL_EMAIL_PREDETERMINADO=

# ---- general
FUSO=America/Asuncion
PUERTO=3000
